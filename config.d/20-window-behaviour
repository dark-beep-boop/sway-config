### Window behaviour configuration

## Tiling behaviour
exec_always autotiling --limit 2
exec_always /home/zus/.local/bin/autoset_window

## Workspace assignation
# Terminal workspace windows

# Code workspace windows

# Internet workspace windows
assign [app_id="Tor Browser"] 4

# Media workspace windows
for_window [workspace=5] layout tabbed
assign [app_id=spotify] 5
assign [app_id=mpv] 5

# Mail workspace windows
for_window [workspace=6] layout tabbed
assign [app_id="Proton Mail"] 6

# Chat workspace windows
for_window [workspace=7] layout tabbed
assign [app_id=org.telegram.desktop] 7
assign [class=discord] 7
assign [app_id=Slack] 7
assign [class=Mattermost] 7

# Notes workspace windows
for_window [workspace=8] layout tabbed
assign [app_id=obsidian] 8

# Organization workspace windows
for_window [workspace=9] layout tabbed

# Scratchpad windows
for_window [app_id=scratch] move window to scratchpad, resize set 900 540, move position center
for_window [app_id=network] move window to scratchpad, resize set 900 600, move position centes
for_window [class=Bitwarden] move window to scratchpad, resize set 1000 600, move position center, sticky enable
for_window [app_id=thunar] move window to scratchpad, resize set 1000 600, move position center, sticky enable
for_window [app_id=qalculate-gtk] move window to scratchpad, resize set 600 400, move position center, sticky enable
for_window [app_id=protonvpn-app] move window to scratchpad, move position center

## Window default mode
# Floating windows
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [app_id=float] floating enable
for_window [class=zoom] floating enable
for_window [app_id=veracrypt] floating enable
for_window [app_id=lxqt-openssh-askpass] floating enable
for_window [class=ghidra-Ghidra] floating enable
for_window [app_id=blueman-manager] floating enable
for_window [app_id=nm-connection-editor] floating enable

## Window focus
for_window [class=".*"] focus
for_window [app_id=".*"] focus
focus_on_window_activation focus
